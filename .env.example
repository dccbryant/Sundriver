# Copy to .env (or export in your shell / set as GitHub Actions secrets).

# Google Sheets service account JSON file path
GOOGLE_SHEETS_CREDENTIALS=./secrets/sheets-service-account.json

# The Google Sheet ID (the long string in the URL between /d/ and /edit)
SPREADSHEET_ID=1AbcDefGhiJklMnoPqrStuVwxYz1234567890abcdef

# Google Ads
GOOGLE_ADS_YAML=./secrets/google-ads.yaml
GOOGLE_ADS_CUSTOMER_ID=1234567890

# NOAA requires a descriptive User-Agent identifying the app and a contact.
NOAA_USER_AGENT=Sundriver/1.0 (sunscreen ad automation; contact: you@your-domain.com)
